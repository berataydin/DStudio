+        strncmp(rel, "references/", 11) && strncmp(rel, "scripts/", 8)) {
+        snprintf(err, errsz, "pack_file path must be example.html, assets/*, references/*, or scripts/*"); return 0;
+    }
+    if (!ds4ui_pack_file_ext_ok(rel)) { snprintf(err, errsz, "pack_file extension is not allowed"); return 0; }
+    const char *seg = rel;
